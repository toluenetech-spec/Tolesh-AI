{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tolesh",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ORIGIN": "https://origin.example.com"
  }
}
